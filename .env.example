# Copy this file to .env and fill it in. Never share .env or commit it.


CLINIC_TZ=Asia/Kolkata

# First staff account for the desk at /admin (used only when no staff exist yet).
# Sign in with this phone number and password, then add or remove other staff
# from the Staff tab. After the first start you can delete these three lines.
ADMIN_NAME=Clinic owner
ADMIN_PHONE=7489791016
ADMIN_PASSWORD=choose-a-long-password

# ---------- Booking alerts: who gets told ----------
# Clinic-wide (comma-separated). These get every booking.
NOTIFY_EMAILS=doctor@example.com
# Twilio: digits with country code, e.g. 917489791016
# CallMeBot: number:apikey, e.g. 917489791016:1234567
NOTIFY_WHATSAPP=917489791016:YOUR_CALLMEBOT_APIKEY

# Optional: each dentist also gets their own bookings (ids from shared/clinic.config.js)
# NOTIFY_MAYA_EMAIL=maya@example.com
# NOTIFY_MAYA_WHATSAPP=91XXXXXXXXXX:APIKEY
# NOTIFY_RAVI_EMAIL=
# NOTIFY_LENA_EMAIL=

# Alert the clinic for bookings staff enter at the desk too (default: only online bookings)
NOTIFY_ON_STAFF_BOOKINGS=false
# Email patients a confirmation / cancellation (needs SMTP below)
SEND_PATIENT_EMAIL=true

# ---------- WhatsApp sending ----------
# callmebot (free, for alerts to your own phone) | twilio (business-grade) | none
WHATSAPP_PROVIDER=callmebot
# Twilio only:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio WhatsApp sender, e.g. +14155238886 (sandbox)
TWILIO_WHATSAPP_FROM=

# ---------- Email sending (SMTP) ----------
# Gmail: smtp.gmail.com, port 465, your Gmail address, and a 16-character App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourclinic@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Alder Row Dental <yourclinic@gmail.com>

# ---------- Chat assistant (optional) ----------
# From https://platform.claude.com — leave empty to use the built-in quick answers instead
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-opus-5-5
